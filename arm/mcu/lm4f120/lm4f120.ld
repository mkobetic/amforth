
OUTPUT_FORMAT("elf32-littlearm")
OUTPUT_ARCH(arm)

PVFLASH_PAGE = 1K;
PVFLASH_SIZE = 8K;

MEMORY
{
   FLASH(RX)   : ORIGIN = 0x00000000, LENGTH = 0x40000 - PVFLASH_SIZE
   /* Allocate end of FLASH as PVFLASH */
   PVFLASH(RW) : ORIGIN = ORIGIN(FLASH) + LENGTH(FLASH), LENGTH = PVFLASH_SIZE
   RAM(WAIL)   : ORIGIN = 0x20000000, LENGTH = 0x8000
}

INCLUDE amforth32.ld