/* SPDX-License-Identifier: GPL-3.0-only */
ENTRY( _start )

/* fast flash mode 
FLASH_PAGE = 256;
FLASH_CELL = 256;
*/

/* standard flash mode */
FLASH_PAGE = 4K;
FLASH_CELL = 2; /* bytes */
FLASH_SIZE = 256K;
FLASH_ORIGIN = 0x00000000;
FLASH_ERASED = 0xE339E339; /* a word in erased flash */

/* Allocate end of FLASH as PVFLASH */
PVFLASH_PAGE = FLASH_PAGE;
PVFLASH_CELL = FLASH_CELL;
PVFLASH_SIZE = 4 * FLASH_PAGE;
PVFLASH_ORIGIN = FLASH_ORIGIN + FLASH_SIZE - PVFLASH_SIZE;
PVFLASH_ERASED = FLASH_ERASED;


MEMORY
{
/* CH32V30x_D8C - CH32V305RB-CH32V305FB
   CH32V30x_D8 - CH32V303CB-CH32V303RB
*/
/*
	FLASH (rx) : ORIGIN = 0x00000000, LENGTH = 128K
	RAM (xrw) : ORIGIN = 0x20000000, LENGTH = 32K
*/
    
/* CH32V30x_D8C - CH32V307VC-CH32V307WC-CH32V307RC
   CH32V30x_D8 - CH32V303VC-CH32V303RC
   FLASH + RAM supports the following configuration
   FLASH-192K + RAM-128K
   FLASH-224K + RAM-96K
   FLASH-256K + RAM-64K  
   FLASH-288K + RAM-32K  
*/
	FLASH (rx)  : ORIGIN = FLASH_ORIGIN, LENGTH = FLASH_SIZE - PVFLASH_SIZE
   PVFLASH(rw) : ORIGIN = PVFLASH_ORIGIN, LENGTH = PVFLASH_SIZE
 	RAM (xrw)   : ORIGIN = 0x20000000, LENGTH = 64K

}

INCLUDE amforth32.ld
